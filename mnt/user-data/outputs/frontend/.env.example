# ============================================
# frontend/.env.example
# Copy this to frontend/.env and fill in real values.
# Note: any variable here ends up in the final bundle (Vite) -
# never put a real secret here (no Supabase key, no JWT secret).
# The frontend talks to the backend only, never to Supabase directly.
# ============================================

VITE_API_BASE_URL=http://localhost:8000/api/v1
