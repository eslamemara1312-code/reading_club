# Backend Environment Variables Example for Production (Railway / Supabase)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
JWT_SECRET=production-super-secret-jwt-key-replace-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ENVIRONMENT=production
CORS_ORIGINS=["https://reading-club.vercel.app", "http://localhost:5173"]

# WhatsApp Business Cloud API (Meta)
WHATSAPP_TOKEN=your_meta_system_user_token
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
